# ─── Tempo Server ────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# This file runs on Railway — never commit the real .env to git.

# ─── Supabase ────────────────────────────────────────────────────────────────
# supabase.com → your project → Settings → API
SUPABASE_URL=
# Service role key — has full DB access, server-side only, never in the app
SUPABASE_SERVICE_ROLE_KEY=

# ─── Twelve Labs ─────────────────────────────────────────────────────────────
# twelvelabs.io → Dashboard → API Keys
TWELVE_LABS_API_KEY=

# ─── Anthropic ───────────────────────────────────────────────────────────────
# console.anthropic.com → API Keys. Used for the text-input pipeline (webpage
# / PDF / plain-text workouts) to interpret exercise instructions into
# structured movements — the video pipeline above does not need this.
ANTHROPIC_API_KEY=

# ─── Google Cloud ────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → API Keys
# Make sure YouTube Data API v3 is enabled on this project
YOUTUBE_DATA_API_KEY=

# ─── YouTube cookies (optional) ──────────────────────────────────────────────
# Base64-encoded cookies.txt for yt-dlp, used for age/region-gated YouTube videos.
YOUTUBE_COOKIES_B64=

# ─── Server config ────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── The one user ──────────────────────────────────────────────────────────────
# Tempo has no sign-in flow. Every /process-video request is attributed to
# this Supabase user id. Must match EXPO_PUBLIC_USER_ID in .env.example.
OWNER_USER_ID=
