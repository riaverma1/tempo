# ─── Tempo — Expo App ───────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Variables prefixed with EXPO_PUBLIC_ are bundled into the app.
# Never put service role keys or private secrets in this file.

# ─── Supabase ────────────────────────────────────────────────────────────────
# supabase.com → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── Railway server ───────────────────────────────────────────────────────────
# The public URL Railway assigns to your deployed server.
# Leave blank during local development — app will hit localhost.
EXPO_PUBLIC_API_URL=

# ─── Development flags ────────────────────────────────────────────────────────
# Skip server + use fixture data
EXPO_PUBLIC_USE_MOCK=false

# ─── The one user ──────────────────────────────────────────────────────────────
# Tempo has no sign-in flow — one person, one account. Every screen reads and
# writes as this Supabase user id (a row in auth.users, or any UUID you use
# consistently as the user_id on your rows if you're not using Supabase Auth
# at all). Must match OWNER_USER_ID in server/.env.example.
EXPO_PUBLIC_USER_ID=
