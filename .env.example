# ─── Tempo — Expo App ───────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Variables prefixed with EXPO_PUBLIC_ are bundled into the app.
# Never put service role keys or private secrets in this file.

# ─── Supabase ────────────────────────────────────────────────────────────────
# supabase.com → your project → Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client IDs
# Web client: used by Supabase Auth for the token exchange
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# iOS client: create a separate OAuth client, application type = iOS
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# ─── Railway server ───────────────────────────────────────────────────────────
# The public URL Railway assigns to your deployed server.
# Leave blank during local development — app will hit localhost.
EXPO_PUBLIC_API_URL=

# ─── Development flags ────────────────────────────────────────────────────────
# Skip server + use fixture data (no server or auth needed)
EXPO_PUBLIC_USE_MOCK=false
# Skip auth only — real server pipeline still runs
EXPO_PUBLIC_BYPASS_AUTH=false
